{% comment %}
  results_table.liquid
  ---------------------
  A collapsible results table: closed by default (just a "See full
  results" toggle), styled to match the carousel's purple/grey theme.

  USAGE (in a project .md page):

    {% include results_table.liquid
       title="In-distribution results (avg. across 4 tasks)"
       headers="Method,Success (%),Direct (%),Max Force (N),Time (s)"
       rows=page.id_results %}

  Define rows in front matter as a list of comma-joined strings
  (bold a value by wrapping it in **like this**):

    id_results:
      - "OpenVLA-OFT,58.1,12.4,14.94,126.7"
      - "TactileConcat,64.8,10.5,10.27,113.0"
      - "Cross-Attn,48.0,12.0,13.43,149.9"
      - "**TacFiLM**,**86.7**,**37.1**,**8.65**,**81.7**"
{% endcomment %}

{% assign uid = "rt-" | append: site.time | date: "%N" %}
{% assign header_list = include.headers | split: "," %}

<details class="results-table" id="{{ uid }}"{% if include.open %} open{% endif %}>
  <summary>{{ include.title | default: "See full results table" }}</summary>

  <div class="results-table-scroll">
    <table>
      <thead>
        <tr>
          {% for h in header_list %}
            <th>{{ h }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in include.rows %}
          {% assign is_best_row = false %}
          {% assign row_content = row %}
          {% if row contains "!!" %}
            {% assign is_best_row = true %}
            {% assign row_content = row | remove_first: "!!" %}
          {% endif %}
          {% assign cells = row_content | split: "," %}
          <tr{% if is_best_row %} class="best-row"{% endif %}>
            {% for cell in cells %}
              <td>{{ cell | replace: "[[", '<span class="best">' | replace: "]]", '</span>' | markdownify | remove: "<p>" | remove: "</p>" }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</details>

<style>
  .results-table {
    max-width: 900px;
    margin: 1.5rem auto;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    padding: 0.75rem 1rem;
  }

  .results-table summary {
    cursor: pointer;
    font-weight: 600;
    color: #6b4fbb;
    padding: 0.25rem 0;
    list-style: none;
  }

  .results-table summary::-webkit-details-marker {
    display: none;
  }

  .results-table summary::before {
    content: "▸ ";
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .results-table[open] summary::before {
    transform: rotate(90deg);
  }

  .results-table-scroll {
    overflow-x: auto;
    margin-top: 0.75rem;
  }

  .results-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .results-table th,
  .results-table td {
    padding: 8px 12px;
    text-align: left;
    white-space: nowrap;
  }

  .results-table th {
    color: #5a5a5a;
    font-weight: 600;
    border-bottom: 2px solid #e2e2e2;
  }

  .results-table td {
    color: #5a5a5a;
    border-bottom: 1px solid #f0f0f0;
  }

  .results-table td strong {
    color: #2b2b2b;
    font-weight: 600;
  }

  .results-table td .best {
    background: #ece4fb;
    color: #6b4fbb;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .results-table tr.best-row {
    background: #f7f3fd;
  }

  .results-table tr.best-row td {
    color: #4a3a70;
  }
</style>
